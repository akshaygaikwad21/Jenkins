step 4-  For this we need 3 EC servers
		i.e 
		Tomcat -- t2.micro
		Jenkins -- t2.medium
		Sonarqube -- t2.medium
		
		
		
Step 5 - below pipeline script  used for pull build test and deploy.

pipeline{
    agent any
    stages{
        stage('pull'){
            steps{
                git 'https://github.com/akshaygaikwad21/sonar.git'
            }
        }
        stage('build'){
            steps{
                sh '/opt/maven/bin/mvn clean package'
            }
        }
        stage('test'){
            steps{
                withSonarQubeEnv(installationName: 'sonar-install2', credentialsId: 'Jenkins2sonar') {
                sh '''
                    /opt/maven/bin/mvn sonar:sonar \
                    -Dsonar.projectKey=studentapp \
                    -Dsonar.projectName=studentapp
                '''

}
                
            }
        }
        stage('deploy'){
            steps{
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tom', path: '', url: 'http://13.233.144.26:8080/')], contextPath: '/', war: '**/*.war'
            }
        }
    }
}



